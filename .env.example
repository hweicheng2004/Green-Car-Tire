# Copy to .env.local (Next.js) and .env (scripts). Never commit the real file.

# From https://developer.wheel-size.com/ (free sandbox key: 300 hits/day, testing only)
WHEELSIZE_API_KEY=
# Markets to query and merge. Keep usdm: Wheel-Size tags many Canadian trims as US-only.
WHEELSIZE_REGIONS=cdm,usdm
# Match your plan: sandbox 300, Basic 5000, Business 30000
WHEELSIZE_DAILY_LIMIT=300
# Days before a cached vehicle is re-fetched
WHEELSIZE_CACHE_DAYS=180

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Sheets sync (phase 2)
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# The service account's JSON key file, pasted whole (one line is fine). Share the sheet with its client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Tab names. Several tabs of one kind: comma-separated, e.g. "Tires,Used tires"
SHEETS_TIRE_TABS=Tires
SHEETS_WHEEL_TABS=Wheels
# Created by the sync if missing. Rewritten on every change.
SHEETS_ISSUES_TAB=Sync issues
SHOP_TIMEZONE=America/Toronto
# Any long random string. The 5-minute schedule (supabase/cron-sync.sql) sends it. Generate: openssl rand -hex 32
CRON_SECRET=
