{
  "compilerOptions": {
    "target": "ES2020", "lib": ["dom", "dom.iterable", "esnext"], "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowJs": true, "incremental": true, "isolatedModules": true, "jsx": "preserve", "plugins": [{ "name": "next" }],
    "baseUrl": ".", "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.mts", ".next/types/**/*.ts"], "exclude": ["node_modules"]
}
